{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["es2022"],
        "strict": true,
        "noImplicitReturns": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"],
        "paths": {
            "@cdk/*": ["./cdk/*"],
            "@test/*": ["./test/*"]
        }
    },
    "include": ["bin/**/*", "cdk/**/*", "test/cdk/**/*"]
}
